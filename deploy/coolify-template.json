{
  "version": "1.0",
  "name": "Stella — Atendimento IA (Sancar)",
  "description": "Stack completa: Chatwoot v4.19.0 + n8n + Evolution API v2 + PostgreSQL 16 (pgvector) + Redis 7. Pronta para importar no Coolify.",
  "logo": "https://raw.githubusercontent.com/chatwoot/chatwoot/develop/app/javascript/dashboard/assets/images/chatwoot_logo.svg",
  "tags": ["chatwoot", "n8n", "whatsapp", "ia", "atendimento", "stella", "sancar"],
  "services": {
    "postgres": {
      "image": "pgvector/pgvector:pg16",
      "restart": "unless-stopped",
      "environment": {
        "POSTGRES_DB": "chatwoot",
        "POSTGRES_USER": "postgres",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}"
      },
      "volumes": ["postgres_data:/var/lib/postgresql/data"],
      "healthcheck": {
        "test": ["CMD-SHELL", "pg_isready -U postgres"],
        "interval": "10s",
        "timeout": "5s",
        "retries": 5
      }
    },
    "redis": {
      "image": "redis:7-alpine",
      "restart": "unless-stopped",
      "command": ["redis-server", "--requirepass", "${REDIS_PASSWORD}"],
      "volumes": ["redis_data:/data"]
    },
    "rails": {
      "image": "chatwoot/chatwoot:v4.19.0",
      "restart": "unless-stopped",
      "depends_on": ["postgres", "redis"],
      "environment": {
        "RAILS_ENV": "production",
        "NODE_ENV": "production",
        "INSTALLATION_ENV": "docker",
        "SECRET_KEY_BASE": "${SECRET_KEY_BASE}",
        "FRONTEND_URL": "https://${CHATWOOT_HOST}",
        "DEFAULT_LOCALE": "pt_BR",
        "POSTGRES_HOST": "postgres",
        "POSTGRES_DB": "chatwoot",
        "POSTGRES_USERNAME": "postgres",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}",
        "REDIS_URL": "redis://:${REDIS_PASSWORD}@redis:6379"
      },
      "volumes": ["chatwoot_storage:/app/storage"],
      "entrypoint": "docker/entrypoints/rails.sh",
      "command": ["bundle", "exec", "rails", "s", "-p", "3000", "-b", "0.0.0.0"],
      "port": 3000,
      "proxy": {
        "domain": "${CHATWOOT_HOST}",
        "port": 3000
      }
    },
    "sidekiq": {
      "image": "chatwoot/chatwoot:v4.19.0",
      "restart": "unless-stopped",
      "depends_on": ["postgres", "redis", "rails"],
      "environment": {
        "RAILS_ENV": "production",
        "NODE_ENV": "production",
        "INSTALLATION_ENV": "docker",
        "SECRET_KEY_BASE": "${SECRET_KEY_BASE}",
        "FRONTEND_URL": "https://${CHATWOOT_HOST}",
        "POSTGRES_HOST": "postgres",
        "POSTGRES_DB": "chatwoot",
        "POSTGRES_USERNAME": "postgres",
        "POSTGRES_PASSWORD": "${POSTGRES_PASSWORD}",
        "REDIS_URL": "redis://:${REDIS_PASSWORD}@redis:6379"
      },
      "volumes": ["chatwoot_storage:/app/storage"],
      "command": ["bundle", "exec", "sidekiq", "-C", "config/sidekiq.yml"]
    },
    "n8n": {
      "image": "n8nio/n8n:latest",
      "restart": "unless-stopped",
      "depends_on": ["postgres"],
      "environment": {
        "N8N_HOST": "${N8N_HOST}",
        "N8N_PORT": "5678",
        "N8N_PROTOCOL": "https",
        "WEBHOOK_URL": "https://${N8N_HOST}/",
        "N8N_ENCRYPTION_KEY": "${N8N_ENCRYPTION_KEY}",
        "DB_TYPE": "postgresdb",
        "DB_POSTGRESDB_HOST": "postgres",
        "DB_POSTGRESDB_PORT": "5432",
        "DB_POSTGRESDB_DATABASE": "n8n",
        "DB_POSTGRESDB_USER": "postgres",
        "DB_POSTGRESDB_PASSWORD": "${POSTGRES_PASSWORD}"
      },
      "volumes": ["n8n_data:/home/node/.n8n"],
      "port": 5678,
      "proxy": {
        "domain": "${N8N_HOST}",
        "port": 5678
      }
    },
    "evolution": {
      "image": "atendai/evolution-api:v2.2.3",
      "restart": "unless-stopped",
      "depends_on": ["postgres", "redis"],
      "environment": {
        "SERVER_URL": "https://${EVOLUTION_HOST}",
        "AUTHENTICATION_API_KEY": "${EVOLUTION_API_KEY}",
        "DATABASE_PROVIDER": "postgresql",
        "DATABASE_CONNECTION_URI": "postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/evolution?schema=public",
        "CACHE_REDIS_ENABLED": "true",
        "CACHE_REDIS_URI": "redis://:${REDIS_PASSWORD}@redis:6379/6",
        "CHATWOOT_ENABLED": "true",
        "LOG_LEVEL": "ERROR",
        "DEL_INSTANCE": "false"
      },
      "volumes": ["evolution_data:/evolution/instances"],
      "port": 8080,
      "proxy": {
        "domain": "${EVOLUTION_HOST}",
        "port": 8080
      }
    }
  },
  "volumes": {
    "postgres_data": {},
    "redis_data": {},
    "chatwoot_storage": {},
    "n8n_data": {},
    "evolution_data": {}
  },
  "variables": [
    {
      "key": "CHATWOOT_HOST",
      "description": "Domínio do Chatwoot (ex: chat.cliente.com.br)",
      "required": true
    },
    {
      "key": "N8N_HOST",
      "description": "Domínio do n8n (ex: automacao.cliente.com.br)",
      "required": true
    },
    {
      "key": "EVOLUTION_HOST",
      "description": "Domínio da Evolution API (ex: whatsapp.cliente.com.br)",
      "required": true
    },
    {
      "key": "POSTGRES_PASSWORD",
      "description": "Senha do PostgreSQL",
      "required": true,
      "generate": "random"
    },
    {
      "key": "REDIS_PASSWORD",
      "description": "Senha do Redis",
      "required": true,
      "generate": "random"
    },
    {
      "key": "SECRET_KEY_BASE",
      "description": "Chave secreta do Rails (mín. 128 chars)",
      "required": true,
      "generate": "random_hex_128"
    },
    {
      "key": "N8N_ENCRYPTION_KEY",
      "description": "Chave de criptografia do n8n",
      "required": true,
      "generate": "random"
    },
    {
      "key": "EVOLUTION_API_KEY",
      "description": "API key da Evolution API",
      "required": true,
      "generate": "random"
    }
  ],
  "post_deploy": [
    "docker compose exec rails bundle exec rails db:chatwoot_prepare"
  ],
  "documentation": "https://github.com/sancar-space/chatwoot/blob/develop/deploy/README.md"
}
