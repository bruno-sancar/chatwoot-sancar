# ═══════════════════════════════════════════════════════════════
# Stella — Template de Variáveis de Ambiente
# Copie para .env e preencha todos os valores marcados com TODO
# NUNCA commite o arquivo .env no repositório
# ═══════════════════════════════════════════════════════════════

# ── Domínios ───────────────────────────────────────────────────
# TODO: Subdomínio do Chatwoot (ex: chat.cliente.com.br)
CHATWOOT_HOST=chat.cliente.com.br

# TODO: Subdomínio do n8n (ex: automacao.cliente.com.br)
N8N_HOST=automacao.cliente.com.br

# TODO: Subdomínio do Evolution API (ex: whatsapp.cliente.com.br)
EVOLUTION_HOST=whatsapp.cliente.com.br

# ── Portas (alterar apenas se houver conflito) ─────────────────
CHATWOOT_PORT=3000
N8N_PORT=5678
EVOLUTION_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_USER=postgres
# TODO: Senha forte para o banco (mín. 32 caracteres)
POSTGRES_PASSWORD=
POSTGRES_DB=chatwoot

# ── Redis ──────────────────────────────────────────────────────
# TODO: Senha forte para o Redis (mín. 32 caracteres)
REDIS_PASSWORD=

# ── Chatwoot ───────────────────────────────────────────────────
# TODO: Chave secreta do Rails (gerar com: openssl rand -hex 64)
SECRET_KEY_BASE=

# URL do banco para o Chatwoot
DATABASE_URL=postgresql://postgres:${POSTGRES_PASSWORD}@postgres:5432/chatwoot

# URL do Redis para o Chatwoot
REDIS_URL=redis://:${REDIS_PASSWORD}@redis:6379

# TODO: Nome da instalação (aparece no e-mail, etc.)
INSTALLATION_NAME=Stella

# E-mail do admin inicial
# TODO: E-mail do primeiro usuário administrador
DEFAULT_LOCALE=pt_BR
FORCE_SSL=true

# SMTP para envio de e-mails
# TODO: Configurar SMTP do cliente
SMTP_ADDRESS=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_PORT=587
SMTP_AUTHENTICATION=plain
SMTP_ENABLE_STARTTLS_AUTO=true
SMTP_OPENSSL_VERIFY_MODE=peer
MAILER_SENDER_EMAIL=

# Storage (deixar vazio para armazenamento local no volume Docker)
# Para S3/R2: preencher as variáveis abaixo
ACTIVE_STORAGE_SERVICE=local
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_REGION=
# S3_BUCKET_NAME=
# STORAGE_BUCKET_NAME=

# Logs
LOG_LEVEL=warn
LOG_SIZE=500

# ── n8n ────────────────────────────────────────────────────────
# TODO: Chave de encriptação do n8n (gerar com: openssl rand -hex 32)
N8N_ENCRYPTION_KEY=

# SMTP do n8n (pode usar o mesmo do Chatwoot)
N8N_SMTP_HOST=
N8N_SMTP_USER=
N8N_SMTP_PASS=

# Timezone
TIMEZONE=America/Sao_Paulo

# ── Evolution API ──────────────────────────────────────────────
# TODO: Chave de API do Evolution (gerar com: openssl rand -hex 32)
EVOLUTION_API_KEY=

# ── LLMs (configurados diretamente no n8n, não aqui) ──────────
# Os workflows n8n armazenam as chaves de API dos LLMs internamente.
# Use as credenciais do n8n para: DeepSeek, OpenAI, Groq, ElevenLabs.
